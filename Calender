.row div{flex:1;background:var(--tb);border-radius:12px;padding:8px 4px;text-align:center;font-size:13px}
.row b{display:block;font-size:20px;color:var(--pr)}
.row small{color:var(--mu)}
.nav{display:flex;align-items:center;justify-content:space-between}
.nav button{background:var(--tb);color:var(--pr);border:0;border-radius:10px;width:40px;height:40px;font-size:18px}
.nav .t{text-align:center}
.nav .t b{font-size:17px}
.nav .t div{font-size:12px;color:var(--mu)}
